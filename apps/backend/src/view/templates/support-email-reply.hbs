<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reply from Support</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #1976d2;
        color: white;
        text-align: center;
        padding: 24px 20px;
        border-radius: 5px 5px 0 0;
      }
      .header h1 {
        margin: 0;
        font-size: 22px;
      }
      .content {
        background-color: #f9f9f9;
        padding: 30px;
        border-radius: 0 0 5px 5px;
        border: 1px solid #e0e0e0;
        border-top: none;
      }
      .original-message {
        background-color: #fff;
        border-left: 4px solid #ccc;
        padding: 12px 16px;
        margin: 20px 0;
        border-radius: 0 4px 4px 0;
        color: #666;
        font-size: 13px;
      }
      .reply-message {
        background-color: #fff;
        border-left: 4px solid #1976d2;
        padding: 12px 16px;
        margin: 20px 0;
        border-radius: 0 4px 4px 0;
        color: #444;
        line-height: 1.7;
      }
      .footer {
        text-align: center;
        margin-top: 20px;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>
  <body>
    <div class='header'>
      <h1>💬 Reply from Support Team</h1>
    </div>
    <div class='content'>
      <h2>Hello {{firstName}},</h2>

      <div class='reply-message'>{{{replyMessage}}}</div>

      <p>Your original message regarding
        <strong>"{{originalSubject}}"</strong>:</p>
      <div class='original-message'>{{originalMessage}}</div>

      <p>If you have further questions, feel free to reach out again.</p>
      <p>Best regards,<br />The Support Team</p>
    </div>
    <div class='footer'>
      <p>This email was sent in response to your support request.</p>
    </div>
  </body>
</html>