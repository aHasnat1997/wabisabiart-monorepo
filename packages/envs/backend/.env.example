# ============================================================
# Backend — Example / Template (safe to commit)
# Copy this to .env.local and fill in your values.
# ============================================================

PORT=8080
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rightkitkatie_db?schema=public"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
DEFAULT_AVATAR_URL="placeholders/profile-placeholder.png"
DEFAULT_IMAGE_URL="placeholders/image-placeholder.png"
BUCKET_NAME="rightkitkatie-media"
ENDPOINT="https://media.example.com"
ACCESS_KEY_ID="your_access_key"
SECRET_ACCESS_KEY="your_secret_key"
BCRYPT_SALT_OR_ROUNDS=10
JWT_SECRET="your_very_long_random_jwt_secret_min_32_chars"
ACCESS_TOKEN_COOKIE_NAME="wsa-access-token"
ADMIN_SESSION_SECRET="your_admin_session_secret"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM="WabiSabiArt <your_email@gmail.com>"
APP_URL="http://localhost:8080"
VERIFY_EMAIL_URL_WEBHOOKS="http://localhost:8080"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
ADMIN_EMAIL="admin@admin.com"
ADMIN_FULL_NAME="Admin User"
ADMIN_AVATAR_URL="placeholders/seed-admin.jpg"
ADMIN_PASSWORD="admin@admin.com"
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_secret"
SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"
ETSY_API_KEY="your_etsy_keystring"
ETSY_API_SECRET="your_etsy_shared_secret"
