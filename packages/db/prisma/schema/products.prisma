model Product {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String        @db.Uuid
  title             String?       @db.Text
  subtitle          String?       @db.Text
  description       String?       @db.Text
  badge             String?       @default("new")
  price             Decimal?      @db.Decimal(12, 2)
  currency          String        @default("USD") @db.Text
  discountType      DiscountType  @default(none)
  discountValue     Decimal?      @db.Decimal(12, 2)
  trackInventory    Boolean       @default(true)
  lowStockThreshold Int           @default(5)
  status            ProductStatus @default(pending_review)
  categoryType      CategoryType? @default(crafts)
  categoryId        String?       @db.Uuid
  subCategoryId     String?       @db.Uuid
  promotionId       String?       @db.Uuid
  isFeatured        Boolean       @default(false)
  tags              String[]      @default([])
  customizable      Boolean       @default(false)
  handmade          Boolean       @default(false)
  madeToOrder       Boolean       @default(false)
  processingTime    Int?
  favoriteCount     Int           @default(0)
  salesCount        Int           @default(0)
  reportCount       Int           @default(0)
  averageRating     Decimal       @default(0.00) @db.Decimal(3, 2)
  deletedAt         DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  seller                User                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory           SubCategory?           @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  promotion             Promotion?             @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  variants              ProductVariant[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  reviews               Review[]
  inventoryReservations InventoryReservation[]

  @@index([sellerId])
  @@index([status])
  @@index([isFeatured])
  @@index([deletedAt])
  @@schema("product")
}

model ProductVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  mediaUrl   String?  @default("placeholders/image-placeholder.png") @db.Text
  name       String   @db.Text
  quantity   Int      @default(0)
  options    Json?    @db.Json
  isLowStock Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItem   CartItem[]

  @@index([productId])
  @@index([isActive])
  @@index([isLowStock])
  @@schema("product")
}
