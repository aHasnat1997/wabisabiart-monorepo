model SellerPayout {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String    @db.Uuid
  period             String    @db.Text // "2026-04" format (year-month)
  grossRevenue       Decimal   @db.Decimal(12, 2)
  refundsIssued      Decimal   @db.Decimal(12, 2)
  platformFeePercent Decimal   @db.Decimal(5, 2)
  platformFeeAmount  Decimal   @db.Decimal(12, 2)
  netPayment         Decimal   @db.Decimal(12, 2)
  status             String    @default("pending") @db.Text // "pending" | "approved" | "paid" | "failed"
  dueDate            DateTime  @db.Timestamptz(6)
  paidDate           DateTime? @db.Timestamptz(6)
  paymentMethod      String?   @db.Text // "bank_transfer" | "wallet" | "check"
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, period])
  @@index([status, dueDate])
  @@index([createdAt])
  @@schema("seller")
}
