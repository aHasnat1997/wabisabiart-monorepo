model Promotion {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String                @db.Uuid
  name            String                @db.Text
  discountType    PromotionDiscountType
  discountValue   Decimal               @db.Decimal(12, 2)
  applyTo         PromotionApplyTo
  startDate       DateTime              @db.Timestamptz(6)
  endDate         DateTime?             @db.Timestamptz(6)
  isActive        Boolean               @default(true)
  minimumPurchase Decimal               @default(0) @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int                   @default(0)
  onePerCustomer  Boolean               @default(false)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  seller     SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  usageLogs  PromotionUsageLog[]
  categories Category[]
  products   Product[]

  @@index([sellerId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@schema("promotion")
}

model PromotionUsageLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId    String   @db.Uuid
  orderId        String   @db.Text
  customerId     String   @db.Uuid
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([customerId])
  @@index([orderId])
  @@schema("promotion")
}
