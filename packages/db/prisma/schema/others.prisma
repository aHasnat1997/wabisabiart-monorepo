model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.Text
  entityType String   @db.Text
  entityId   String?  @db.Uuid
  metadata   Json?    @db.JsonB
  ipAddress  String   @db.Inet
  userAgent  String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@schema("others")
}

model PlatformFeeSetting {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                      String   @unique @default("default") @db.Text
  platformFeePercent       Decimal  @default(5.00) @db.Decimal(5, 2)
  paymentProcessingPercent Decimal  @default(2.90) @db.Decimal(5, 2)
  paymentProcessingFlat    Decimal  @default(0.30) @db.Decimal(10, 2)
  notes                    String?  @db.Text
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("others")
}

model SearchHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  query        String   @db.Text
  filters      Json?    @db.JsonB
  resultsCount Int
  searchedAt   DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([searchedAt])
  @@schema("others")
}

model ShopFollower {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  sellerId   String   @db.Uuid
  followedAt DateTime @default(now()) @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerId])
  @@index([userId])
  @@index([sellerId])
  @@schema("others")
}

model Announcement {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String    @db.Uuid
  title     String    @db.Text
  content   String    @db.Text
  isActive  Boolean   @default(true)
  startsAt  DateTime? @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([sellerId, isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@schema("others")
}

model InventoryReservation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String    @db.Uuid
  quantity    Int
  reservedFor String    @db.Text
  expiresAt   DateTime  @db.Timestamptz(6)
  releasedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([expiresAt])
  @@index([reservedFor])
  @@schema("others")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String?      @db.Uuid
  productId      String       @db.Uuid
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(pending)
  reviewedBy     String?      @db.Uuid
  resolution     String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  reviewedAt     DateTime?    @db.Timestamptz(6)

  reporter     User  @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@unique([reporterId, productId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([productId])
  @@index([status])
  @@schema("others")
}
